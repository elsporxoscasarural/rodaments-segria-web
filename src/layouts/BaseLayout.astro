---
// Layout base de todas las páginas: sistema de diseño, cabecera, pie y metadatos. Ver DESIGN.md.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** La página empieza con una foto a pantalla completa: la cabecera arranca transparente. */
	portada?: boolean;
}
const { title, description, portada = false } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#14163F" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		<Header sobreFoto={portada} />
		<main id="contenido" class:list={{ 'con-cabecera': !portada }}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.saltar {
		position: absolute;
		top: -100px;
		left: var(--g);
		z-index: calc(var(--z-nav) + 10);
		padding: var(--s-3) var(--s-4);
		background: var(--azul);
		color: var(--n0);
		font-weight: 700;
	}
	.saltar:focus {
		top: var(--s-3);
	}
	/* Deja hueco a la cabecera fija en las páginas sin portada */
	.con-cabecera {
		padding-top: 76px;
	}
</style>

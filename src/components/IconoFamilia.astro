---
// Iconos de familia dibujados a medida: línea fina, sin cajas ni círculos de color (ver DESIGN.md).
// Usan currentColor, así que toman el color del texto que los rodea.
interface Props {
	icono: 'rodamiento' | 'transmision' | 'estanqueidad' | 'taller' | 'agricola' | 'gas';
	class?: string;
}
const { icono, class: clase } = Astro.props;
---

<svg class:list={['icono-familia', clase]} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
	{
		icono === 'rodamiento' && (
			<>
				<circle cx="24" cy="24" r="20" />
				<circle cx="24" cy="24" r="8.5" />
				<circle cx="24" cy="24" r="4" />
				<g class="lleno">
					<circle cx="24" cy="9.8" r="3" />
					<circle cx="36.3" cy="16.9" r="3" />
					<circle cx="36.3" cy="31.1" r="3" />
					<circle cx="24" cy="38.2" r="3" />
					<circle cx="11.7" cy="31.1" r="3" />
					<circle cx="11.7" cy="16.9" r="3" />
				</g>
			</>
		)
	}
	{
		icono === 'transmision' && (
			<>
				<circle cx="14" cy="24" r="10" />
				<circle cx="14" cy="24" r="3" />
				<circle cx="37" cy="24" r="6.5" />
				<circle cx="37" cy="24" r="2" />
				<path d="M14 12.5 37 16M14 35.5 37 32" />
			</>
		)
	}
	{
		icono === 'estanqueidad' && (
			<>
				<circle cx="20" cy="26" r="16" />
				<circle cx="20" cy="26" r="9.5" />
				<path d="M38 5c-3 4.4-4.6 7.3-4.6 9.4a4.6 4.6 0 0 0 9.2 0C42.6 12.3 41 9.4 38 5Z" />
			</>
		)
	}
	{
		icono === 'taller' && (
			<>
				<rect x="5" y="17" width="38" height="24" />
				<path d="M17 17v-6h14v6M5 27h38M21 25v5h6v-5" />
			</>
		)
	}
	{
		icono === 'agricola' && (
			<>
				<circle cx="15" cy="32" r="10" />
				<circle cx="15" cy="32" r="3" />
				<circle cx="38" cy="36" r="6" />
				<path d="M8 22.5V9h12l4 13h15v8.5M24 9v13M25 36h7" />
			</>
		)
	}
	{
		icono === 'gas' && (
			<>
				<path d="M17 16a7 7 0 0 1 14 0v26H17z" />
				<path d="M21 9h6M24 5v4M17 24h14" />
			</>
		)
	}
</svg>

<style>
	.icono-familia {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.icono-familia .lleno {
		fill: currentColor;
		stroke: none;
	}
</style>

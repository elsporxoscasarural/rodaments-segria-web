---
// Portada de la home: la fachada desde la calle y, al hacer scroll, se abre el almacén por dentro.
// Prototipo aprobado: docs/prototipos/portada-b.html. Reglas: DESIGN.md (nunca texto encima del edificio).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { empresa, formatoNumero } from '../../data/empresa';
import fachada from '../../assets/img/fotos/fachada-rodaments-segria-lleida.jpg';
import nave from '../../assets/img/fotos/nave-almacen-suministro-industrial.jpg';

const marcas = (await getCollection('marcas', (m) => m.data.publicar && m.id !== 'carburos-metalicos'))
	.sort((a, b) => a.data.orden - b.data.orden)
	.map((m) => m.data.nombre);
const generacion = ['Primera', 'Segunda', 'Tercera', 'Cuarta', 'Quinta'][empresa.generacionActual - 1];
---

<section class="secuencia" aria-label="Portada">
	<div class="escena">
		<div class="capa fachada">
			<Image
				src={fachada}
				alt="Fachada de la nave de Rodaments Segrià en el Polígono Camí dels Frares de Lleida"
				widths={[800, 1200, 1600, 2000]}
				sizes="(max-width: 820px) 160vw, 75vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
		<div class="panel" aria-hidden="true"></div>
		<div class="capa nave">
			<Image
				src={nave}
				alt="Interior del almacén: estanterías llenas de rodamientos, correas y recambios"
				widths={[800, 1200, 1600, 2048]}
				sizes="100vw"
			/>
		</div>

		<div class="portada">
			<div>
				<p class="origen">
					<svg viewBox="0 0 48 48" aria-hidden="true">
						<circle class="aro" cx="24" cy="24" r="21"></circle>
						<circle class="aro" cx="24" cy="24" r="9"></circle>
						<g class="bolas">
							<circle cx="24" cy="9" r="3.4"></circle><circle cx="34.6" cy="13.4" r="3.4"></circle>
							<circle cx="39" cy="24" r="3.4"></circle><circle cx="34.6" cy="34.6" r="3.4"></circle>
							<circle cx="24" cy="39" r="3.4"></circle><circle cx="13.4" cy="34.6" r="3.4"></circle>
							<circle cx="9" cy="24" r="3.4"></circle><circle cx="13.4" cy="13.4" r="3.4"></circle>
						</g>
					</svg>
					<span>{empresa.direccion.localidad}, desde {empresa.fundacion}</span>
				</p>
				<h1>Rodamientos y suministro industrial en Lleida</h1>
			</div>
			<div class="lado">
				<p>
					Más de {formatoNumero(empresa.referenciasEnStock)} referencias en stock para la industria, el campo y el
					taller.
				</p>
				<div class="acciones">
					<a class="btn btn--noche" href="#productos">Ver catálogo</a>
					<a class="btn btn--claro" href="#referencia">Buscar referencia</a>
				</div>
			</div>
		</div>
		<div class="pista" aria-hidden="true">Nuestro almacén por dentro<i></i></div>

		<div class="dentro">
			<p>
				<span class="linea">Desde {empresa.fundacion}.</span>
				<span class="linea"><em>{formatoNumero(empresa.referenciasEnStock)} referencias</em></span>
				<span class="linea">en {formatoNumero(empresa.metrosAlmacen)} m² de almacén.</span>
				<span class="linea">{generacion} generación.</span>
			</p>
			{
				marcas.length > 0 && (
					<p class="marcas">
						<span>Marcas en stock</span>
						{marcas.join(' ')}
					</p>
				)
			}
		</div>
	</div>
</section>

<style>
	.secuencia {
		position: relative;
		height: 340vh;
		background: var(--noche);
	}
	.escena {
		--panel: clamp(400px, 40vw, 640px);
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100svh;
		min-height: 560px;
		overflow: hidden;
		background: var(--azul);
		color: var(--n0);
	}
	.capa {
		position: absolute;
		inset: 0;
		will-change: transform, clip-path;
	}
	.capa :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Escritorio: panel azul a la izquierda que se funde con el cielo; la fachada, entera a la derecha. */
	.fachada {
		left: calc(var(--panel) - 9vw);
		transform-origin: 70% 55%;
		-webkit-mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.35) 5vw, rgb(0 0 0 / 0.8) 10vw, #000 16vw);
		mask-image: linear-gradient(90deg, transparent 0, rgb(0 0 0 / 0.35) 5vw, rgb(0 0 0 / 0.8) 10vw, #000 16vw);
	}
	.fachada :global(img) {
		object-position: 60% 45%;
	}
	.fachada::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, oklch(22.7% 0.077 276.3 / 0.28) 0%, transparent 18%);
	}
	.panel {
		position: absolute;
		inset: 0 auto 0 0;
		z-index: 1;
		width: calc(var(--panel) + 7vw);
		background: linear-gradient(
			90deg,
			var(--azul) 0,
			var(--azul) calc(100% - 16vw),
			oklch(54.3% 0.252 262.1 / 0.86) calc(100% - 12.5vw),
			oklch(54.3% 0.252 262.1 / 0.55) calc(100% - 8.5vw),
			oklch(54.3% 0.252 262.1 / 0.24) calc(100% - 4.5vw),
			oklch(54.3% 0.252 262.1 / 0.07) calc(100% - 1.5vw),
			oklch(54.3% 0.252 262.1 / 0) 100%
		);
	}
	/* En reposo la nave está oculta: se abre desde la puerta de la fachada al hacer scroll. */
	.nave {
		z-index: 2;
		visibility: hidden;
		clip-path: inset(55% 20% 45% 80%);
	}
	.nave :global(img) {
		object-position: 50% 45%;
	}
	.nave::after {
		content: '';
		position: absolute;
		inset: 0;
		background: oklch(22.7% 0.077 276.3 / 0.55);
	}

	.portada {
		position: absolute;
		inset: 0 auto 0 0;
		z-index: 3;
		width: var(--panel);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--s-6);
		padding: 96px var(--g) clamp(28px, 6vh, 64px);
	}
	h1 {
		color: var(--n0);
		font-size: clamp(3rem, 5.4vw, 6rem);
		line-height: var(--lh-display);
	}
	.lado p {
		margin-bottom: var(--s-5);
		max-width: 34ch;
		font-size: var(--t-lead);
		color: oklch(98.9% 0.003 286.4 / 0.94);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-3);
	}

	/* «Lleida, desde 1988» con un rodamiento que gira */
	.origen {
		display: flex;
		align-items: center;
		gap: 14px;
		max-width: none;
		margin-bottom: var(--s-5);
		font-family: var(--f-display);
		font-weight: 800;
		font-size: clamp(1.4rem, 1.9vw, 1.9rem);
		line-height: 1;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}
	.origen svg {
		flex: none;
		width: 1.45em;
		height: 1.45em;
	}
	.origen .aro {
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
	}
	.origen .bolas {
		fill: currentColor;
		transform-origin: 24px 24px;
		animation: gira 7s linear infinite;
	}
	.origen span {
		clip-path: inset(0 100% 0 0);
		animation: escribe 1.1s var(--ease) 0.35s forwards;
	}
	.origen::after {
		content: '';
		width: 0;
		height: 2px;
		background: oklch(98.9% 0.003 286.4 / 0.55);
		animation: linea 1.2s var(--ease) 1.1s forwards;
	}
	@keyframes gira {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes escribe {
		to {
			clip-path: inset(0 0 0 0);
		}
	}
	@keyframes linea {
		to {
			width: clamp(28px, 4vw, 64px);
		}
	}

	.pista {
		position: absolute;
		left: calc(var(--panel) + (100% - var(--panel)) / 2);
		bottom: var(--s-4);
		z-index: 3;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--s-2);
		font-size: var(--t-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: oklch(98.9% 0.003 286.4 / 0.85);
	}
	.pista i {
		position: relative;
		width: 1px;
		height: 34px;
		overflow: hidden;
		background: oklch(98.9% 0.003 286.4 / 0.35);
	}
	.pista i::after {
		content: '';
		position: absolute;
		left: 0;
		top: -40%;
		width: 1px;
		height: 40%;
		background: var(--n0);
		animation: baja 1.8s var(--ease) infinite;
	}
	@keyframes baja {
		to {
			top: 100%;
		}
	}

	/* Dentro del almacén: las cifras línea a línea */
	.dentro {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 0 var(--g);
		pointer-events: none;
	}
	.dentro p {
		max-width: none;
	}
	.linea {
		display: block;
		opacity: 0;
		font-family: var(--f-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(2.5rem, 7vw, 7rem);
		line-height: 1;
	}
	.linea em {
		font-style: normal;
		color: var(--azul-claro);
	}
	.marcas {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px 28px;
		margin-top: clamp(24px, 4vh, 44px);
		opacity: 0;
		font-family: var(--f-display);
		font-weight: 800;
		font-size: clamp(1.25rem, 2.2vw, 1.75rem);
		text-transform: uppercase;
		color: oklch(98.9% 0.003 286.4 / 0.62);
	}
	.marcas span {
		flex-basis: 100%;
		font-family: var(--f-texto);
		font-weight: 600;
		font-size: var(--t-xs);
		text-transform: none;
		color: oklch(98.9% 0.003 286.4 / 0.92);
	}

	/* Móvil: el texto arriba sobre el azul del logo, que se funde con el cielo; la fachada abajo, despejada. */
	@media (max-width: 820px) {
		.panel {
			display: none;
		}
		.fachada {
			inset: auto 0 0 0;
			height: 54%;
			-webkit-mask-image: none;
			mask-image: none;
			transform-origin: 72% 55%;
		}
		.fachada::after {
			background: linear-gradient(
				180deg,
				var(--azul) 0%,
				oklch(54.3% 0.252 262.1 / 0.6) 12%,
				oklch(54.3% 0.252 262.1 / 0.28) 22%,
				oklch(54.3% 0.252 262.1 / 0.1) 30%,
				transparent 38%
			);
		}
		.nave {
			clip-path: inset(76% 28% 24% 72%);
		}
		.portada {
			inset: 0 0 auto 0;
			width: auto;
			justify-content: flex-start;
			gap: 14px;
			padding: calc(env(safe-area-inset-top, 0px) + 76px) var(--g) 0;
		}
		.origen {
			gap: 10px;
			margin-bottom: 12px;
			font-size: 1.2rem;
		}
		h1 {
			font-size: clamp(2.15rem, 9.6vw, 2.9rem);
			line-height: 0.94;
		}
		.lado p {
			margin-bottom: 12px;
			font-size: 1rem;
		}
		.acciones .btn {
			padding: 0.8rem 1rem;
			font-size: var(--t-xs);
		}
		.pista {
			display: none;
		}
	}
	@media (max-width: 820px) and (max-height: 760px) {
		.lado p {
			display: none;
		}
	}

	/* Movimiento reducido: sin secuencia fijada; fachada y almacén, una debajo de otra. */
	@media (prefers-reduced-motion: reduce) {
		.secuencia {
			height: auto;
		}
		.escena {
			position: relative;
			height: auto;
			min-height: 0;
			overflow: visible;
		}
		.capa {
			position: relative;
			transform: none !important;
		}
		.fachada {
			left: 0;
			height: 100svh;
			min-height: 560px;
			-webkit-mask-image: none;
			mask-image: none;
		}
		.panel,
		.portada {
			bottom: auto;
			height: 100svh;
		}
		.nave {
			height: 100svh;
			min-height: 520px;
			visibility: visible;
			clip-path: none !important;
		}
		.dentro {
			inset: auto 0 0 0;
			height: 100svh;
		}
		.linea,
		.marcas {
			opacity: 1;
		}
		.origen span {
			clip-path: none;
		}
		.origen::after {
			width: 40px;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reducido) {
		gsap.registerPlugin(ScrollTrigger);
		const lenis = (window as Window & { __lenis?: { on: (e: string, f: () => void) => void } }).__lenis;
		if (lenis) lenis.on('scroll', ScrollTrigger.update);

		// La nave se abre desde la puerta de la fachada (en móvil está en otro sitio de la pantalla).
		const movil = window.matchMedia('(max-width: 820px)').matches;
		const puerta = movil ? 'inset(76% 28% 24% 72%)' : 'inset(55% 20% 45% 80%)';

		gsap
			.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: { trigger: '.secuencia', start: 'top top', end: 'bottom bottom', scrub: 0.6 },
			})
			.to('.portada', { yPercent: -18, opacity: 0, duration: 0.18 }, 0)
			.to('.pista', { opacity: 0, duration: 0.06 }, 0)
			.to('.panel', { opacity: 0, duration: 0.22 }, 0.04)
			.to('.fachada', { scale: 1.45, duration: 0.42, ease: 'power1.in' }, 0)
			.set('.nave', { visibility: 'visible' }, 0.12)
			.fromTo('.nave', { clipPath: puerta }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.34, ease: 'power2.inOut' }, 0.12)
			.fromTo('.nave', { scale: 1.12 }, { scale: 1, duration: 0.5, ease: 'power2.out' }, 0.12)
			.fromTo('.linea', { opacity: 0, y: 40 }, { opacity: 1, y: 0, stagger: 0.07, duration: 0.12, ease: 'power2.out' }, 0.44)
			.to('.marcas', { opacity: 1, duration: 0.1 }, 0.74)
			.to({}, { duration: 0.16 });
	}
</script>

---
// «Cómo pedir una pieza»: el cliente no entra al almacén; nos pide la pieza y la buscamos nosotros.
// Tres pasos reales (la numeración es un orden de verdad). Una línea azul avanza con el scroll.
import { empresa } from '../../data/empresa';

const pasos = [
	{
		titulo: 'Nos dices qué necesitas',
		texto: `En el mostrador, por teléfono (${empresa.telefono.visible}), por email o desde la web. Con la referencia, una foto o la pieza vieja: nos sirve cualquier pista.`,
	},
	{
		titulo: 'La buscamos por ti',
		texto:
			'Comprobamos el stock en nuestro almacén, te proponemos una equivalencia entre marcas si hace falta y te damos presupuesto.',
	},
	{
		titulo: 'Te la llevas o te la enviamos',
		texto:
			'Muchas piezas están en stock y te las llevas al momento. Si no la tenemos, te la conseguimos o te la enviamos a cualquier punto de España.',
	},
];
---

<section class="pedir" aria-labelledby="t-pedir" data-pedir>
	<div class="pedir__cabecera">
		<h2 id="t-pedir">Cómo pedir una pieza</h2>
		<p>Tú nos dices qué necesitas y nosotros nos encargamos del resto. Sin complicaciones y sin perder tiempo.</p>
		<div class="pedir__acciones">
			<a class="btn" href="/buscar-referencia">Consultar una referencia <span class="flecha" aria-hidden="true">→</span></a>
			<a class="pedir__tel" href={`tel:${empresa.telefono.enlace}`}>o llama al {empresa.telefono.visible}</a>
		</div>
	</div>

	<ol class="pasos" data-lista>
		{
			pasos.map((paso, i) => (
				<li class="paso" data-paso>
					<span class="paso__num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3>{paso.titulo}</h3>
					<p>{paso.texto}</p>
				</li>
			))
		}
	</ol>
</section>

<style>
	.pedir {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--s-7) var(--s-8);
		padding: var(--seccion) var(--g);
		background: var(--n0);
	}
	/* El título acompaña al lector mientras recorre los pasos */
	.pedir__cabecera {
		position: sticky;
		top: 120px;
		align-self: start;
		display: grid;
		gap: var(--s-5);
	}
	.pedir__cabecera h2 {
		max-width: 11ch;
		color: var(--noche);
	}
	.pedir__cabecera p {
		max-width: 38ch;
		font-size: var(--t-lead);
	}
	.pedir__acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--s-3) var(--s-5);
	}
	.pedir__tel {
		font-weight: 700;
		color: var(--noche);
		text-decoration: none;
	}
	.pedir__tel:hover {
		color: var(--azul);
	}

	.pasos {
		position: relative;
		display: grid;
		gap: clamp(3rem, 9vh, 6rem);
		margin: 0;
		padding: var(--s-4) 0 var(--s-4) clamp(4.5rem, 8vw, 6.5rem);
		list-style: none;
	}
	/* Vía: línea gris (::before); el progreso azul (::after) crece con el scroll según --avance */
	.pasos::before,
	.pasos::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: clamp(1.4rem, 2.6vw, 2.1rem);
		width: 2px;
		background: var(--n2);
	}
	.pasos::after {
		background: var(--azul);
		transform-origin: top;
		transform: scaleY(var(--avance, 1));
	}
	.paso {
		position: relative;
		max-width: 46ch;
		opacity: 1;
		transition: opacity var(--d-media) var(--ease);
	}
	.paso__num {
		position: absolute;
		top: -0.1em;
		left: calc(-1 * clamp(4.5rem, 8vw, 6.5rem));
		display: grid;
		place-items: center;
		width: clamp(2.8rem, 5.2vw, 4.2rem);
		aspect-ratio: 1;
		background: var(--n0);
		border: 2px solid var(--n3);
		font-family: var(--f-display);
		font-weight: 900;
		font-size: clamp(1.3rem, 2.2vw, 1.8rem);
		line-height: 1;
		color: var(--n5);
		transition:
			background-color var(--d-media) var(--ease),
			border-color var(--d-media) var(--ease),
			color var(--d-media) var(--ease);
	}
	.paso h3 {
		margin-bottom: var(--s-3);
		color: var(--noche);
		font-size: clamp(1.8rem, 3vw, 2.6rem);
	}
	.paso p {
		font-size: 1.0625rem;
	}

	/* Con JS: los pasos se «encienden» al llegar a ellos (sin JS o con movimiento reducido, todo encendido) */
	.pedir.con-avance .paso {
		opacity: 0.4;
	}
	.pedir.con-avance .paso.encendido {
		opacity: 1;
	}
	.pedir .paso.encendido .paso__num,
	.pedir:not(.con-avance) .paso__num {
		background: var(--azul);
		border-color: var(--azul);
		color: var(--n0);
	}

	@media (max-width: 900px) {
		.pedir {
			grid-template-columns: minmax(0, 1fr);
		}
		.pedir__cabecera {
			position: static;
		}
	}
</style>

<script>
	// Avance con el scroll: la línea azul crece y cada paso se enciende al pasar por el centro de la pantalla.
	const seccion = document.querySelector<HTMLElement>('[data-pedir]');
	const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (seccion && !reducido) {
		const lista = seccion.querySelector<HTMLElement>('[data-lista]')!;
		const pasos = [...seccion.querySelectorAll<HTMLElement>('[data-paso]')];
		seccion.classList.add('con-avance');

		let pendiente = false;
		const actualizar = () => {
			pendiente = false;
			const centro = window.innerHeight * 0.55;
			const caja = lista.getBoundingClientRect();
			const avance = Math.min(1, Math.max(0, (centro - caja.top) / caja.height));
			lista.style.setProperty('--avance', avance.toFixed(3));
			for (const paso of pasos) paso.classList.toggle('encendido', paso.getBoundingClientRect().top < centro);
		};
		const pedirFrame = () => {
			if (!pendiente) {
				pendiente = true;
				requestAnimationFrame(actualizar);
			}
		};
		window.addEventListener('scroll', pedirFrame, { passive: true });
		window.addEventListener('resize', pedirFrame);
		actualizar();
	}
</script>

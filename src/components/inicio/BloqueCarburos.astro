---
// Carburos Metálicos con su propia identidad (su verde y su logo). Datos de la familia «gases-industriales».
import { Picture } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';

const familia = await getEntry('familias', 'gases-industriales');
const marca = await getEntry('marcas', 'carburos-metalicos');
const categorias = (await getCollection('categorias', (c) => c.data.familia.id === 'gases-industriales')).sort(
	(a, b) => a.data.orden - b.data.orden,
);
---

{
	familia && (
		<section class="cm" aria-labelledby="t-carburos">
			<div class="cm__texto aparece">
				{marca?.data.logo && marca.data.permisoLogo && (
					<div class="cm__placa">
						<Picture formats={['avif', 'webp']} src={marca.data.logo} alt="Carburos Metálicos" height={40} densities={[1, 2]} />
						<small>Distribuidor autorizado</small>
					</div>
				)}
				<h2 id="t-carburos">Carburos Metálicos en Lleida</h2>
				<p>
					Somos distribuidores autorizados de Carburos Metálicos. Suministramos gases industriales y de soldadura y
					corte, y gestionamos el alquiler, la recarga y el cambio de botellas.
				</p>
				<ul>
					{categorias.map((c) => <li>{c.data.nombre}</li>)}
				</ul>
				<a class="btn cm__boton" href={`/productos/${familia.id}`}>
					Ver gases industriales <span class="flecha" aria-hidden="true">→</span>
				</a>
			</div>
			{familia.data.imagen && (
				<div class="cm__foto">
					<Picture formats={['avif', 'webp']}
						src={familia.data.imagen}
						alt="Camión de Carburos Metálicos cargado de botellas de gas"
						widths={[700, 1000, 1400]}
						sizes="(max-width: 820px) 100vw, 50vw"
					/>
				</div>
			)}
		</section>
	)
}

<style>
	.cm {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		background: var(--cm-verde);
		color: color-mix(in oklch, var(--n0) 92%, transparent);
	}
	.cm__texto {
		padding: var(--seccion) var(--g);
	}
	.cm__placa {
		display: inline-block;
		margin-bottom: var(--s-6);
		padding: var(--s-3) var(--s-4);
		background: var(--n0);
	}
	.cm__placa img {
		width: auto;
		height: 40px;
	}
	.cm__placa small {
		display: block;
		margin-top: var(--s-2);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cm-verde);
	}
	h2 {
		color: var(--n0);
	}
	.cm p {
		margin: var(--s-5) 0 var(--s-5);
		max-width: 44ch;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		margin: 0 0 var(--s-6);
		padding: 0;
		list-style: none;
	}
	li {
		padding: var(--s-2) var(--s-3);
		border: 1px solid color-mix(in oklch, var(--n0) 50%, transparent);
		font-size: var(--t-sm);
	}
	.cm__boton {
		background: var(--n0);
		color: var(--cm-verde);
	}
	.cm__boton:hover {
		background: var(--cm-verde-suave);
	}
	.cm__foto {
		position: relative;
		min-height: 380px;
	}
	.cm__foto img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 62% 55%;
	}
	.cm__foto::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--cm-verde) 0, transparent 35%);
	}
	@media (max-width: 820px) {
		.cm {
			grid-template-columns: minmax(0, 1fr);
		}
		.cm__foto {
			min-height: 240px;
		}
		.cm__foto::after {
			background: linear-gradient(180deg, var(--cm-verde) 0, transparent 40%);
		}
	}
</style>

---
// Rejilla de familias, generada desde src/content/familias. Se usa en la portada y en /productos.
// En la portada, Carburos va aparte (BloqueCarburos); en /productos se incluye con su verde.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import IconoFamilia from './IconoFamilia.astro';

interface Props {
	titulo?: string;
	texto?: string;
	/** Incluir la familia destacada (Carburos Metálicos) como una tarjeta más. */
	conCarburos?: boolean;
	/** Marca el final de la portada para que la cabecera pase a sólida (solo en la home). */
	finPortada?: boolean;
}
const {
	titulo = 'Todo lo que mueve la maquinaria',
	texto = 'Miles de productos de cada familia, en stock en nuestro almacén de Lleida. Por eso muchas piezas te las podemos entregar al momento.',
	conCarburos = false,
	finPortada = true,
} = Astro.props;

const familias = (await getCollection('familias', (f) => conCarburos || !f.data.destacada)).sort(
	(a, b) => a.data.orden - b.data.orden,
);
const categorias = await getCollection('categorias');
const cuantas = (id: string) => categorias.filter((c) => c.data.familia.id === id).length;
---

<section class="familias" id="productos" aria-labelledby="t-familias" data-fin-portada={finPortada ? '' : undefined}>
	<header class="familias__cabecera aparece">
		<h2 id="t-familias">{titulo}</h2>
		<p>{texto}</p>
	</header>

	<ul class="rejilla">
		{
			familias.map((familia, i) => {
				const n = cuantas(familia.id);
				return (
					<li class:list={['aparece', { ancha: i === 0, completa: familia.data.destacada }]}>
						<a class:list={['familia', { 'familia--cm': familia.data.destacada }]} href={`/productos/${familia.id}`}>
							{familia.data.imagen && (
								<Image
									class="familia__foto"
									src={familia.data.imagen}
									alt=""
									widths={[600, 900, 1300]}
									sizes={i === 0 ? '(max-width: 560px) 100vw, 66vw' : '(max-width: 560px) 100vw, 33vw'}
								/>
							)}
							{familia.data.icono && <IconoFamilia class="familia__icono" icono={familia.data.icono} />}
							<span class="familia__cuantas">
								{n} {n === 1 ? 'categoría' : 'categorías'}
							</span>
							<span class="familia__texto">
								<strong>{familia.data.nombre}</strong>
								<span>{familia.data.resumen}</span>
								<span class="familia__ir">
									Ver familia <span class="flecha" aria-hidden="true">→</span>
								</span>
							</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.familias {
		background: var(--n1);
		padding: var(--seccion) var(--g);
	}
	.familias__cabecera {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: var(--s-5) var(--s-7);
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.familias__cabecera h2 {
		max-width: 12ch;
		color: var(--noche);
	}
	.familias__cabecera p {
		max-width: 40ch;
	}

	.rejilla {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-auto-rows: clamp(260px, 30vw, 420px);
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.rejilla .ancha {
		grid-column: span 2;
	}
	/* Carburos (solo en /productos) ocupa una fila entera: así la rejilla queda completa */
	.rejilla .completa {
		grid-column: 1 / -1;
	}
	.familia {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: 100%;
		padding: var(--s-5);
		overflow: hidden;
		background: var(--noche);
		color: var(--n0);
		text-decoration: none;
		isolation: isolate;
	}
	.familia__foto {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.6;
		transition:
			transform var(--d-lenta) var(--ease),
			opacity var(--d-media) var(--ease);
	}
	.familia::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, transparent 35%, oklch(22.7% 0.077 276.3 / 0.88) 100%);
	}
	.familia--cm {
		background: var(--cm-verde);
	}
	.familia--cm::after {
		background: linear-gradient(180deg, transparent 30%, oklch(50.8% 0.132 152.6 / 0.92) 100%);
	}
	.familia:hover .familia__foto,
	.familia:focus-visible .familia__foto {
		transform: scale(1.06);
		opacity: 0.78;
	}
	/* El icono es otro componente: el estilo se le aplica con :global */
	.familia :global(.familia__icono) {
		position: absolute;
		top: var(--s-5);
		left: var(--s-5);
		width: clamp(44px, 4vw, 56px);
		height: auto;
	}
	.familia__cuantas {
		position: absolute;
		top: var(--s-5);
		right: var(--s-5);
		padding: var(--s-1) var(--s-3);
		background: oklch(98.9% 0.003 286.4 / 0.14);
		font-size: var(--t-xs);
		font-weight: 600;
	}
	.familia__texto {
		display: grid;
		gap: var(--s-2);
		max-width: 40ch;
	}
	.familia__texto strong {
		font-family: var(--f-display);
		font-weight: 800;
		font-size: clamp(1.6rem, 2.4vw, 2.15rem);
		line-height: 1;
		text-transform: uppercase;
	}
	.familia__texto > span {
		font-size: var(--t-sm);
		color: oklch(98.9% 0.003 286.4 / 0.88);
	}
	.familia__ir {
		margin-top: var(--s-2);
		font-weight: 700;
		color: var(--n0) !important;
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity var(--d-media) var(--ease),
			transform var(--d-media) var(--ease);
	}
	.familia:hover .familia__ir,
	.familia:focus-visible .familia__ir {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 900px) {
		.rejilla {
			grid-template-columns: 1fr 1fr;
			grid-auto-rows: minmax(240px, 44vw);
		}
	}
	@media (max-width: 560px) {
		.rejilla {
			grid-template-columns: 1fr;
			grid-auto-rows: 260px;
		}
		.rejilla .ancha {
			grid-column: auto;
		}
		.familia__ir {
			opacity: 1;
			transform: none;
		}
	}
	@media (hover: none) {
		.familia__ir {
			opacity: 1;
			transform: none;
		}
	}
</style>

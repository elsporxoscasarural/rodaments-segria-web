---
// Barra fija inferior en móvil: «Llamar» y «Presupuesto» (y WhatsApp cuando exista) siempre a un toque.
// Aparece al dejar atrás la portada, y se oculta al llegar al pie (que ya tiene los datos) o con el menú abierto.
import { empresa } from '../data/empresa';
import { ctaPrincipal } from '../data/navegacion';
---

<nav class="barra" aria-label="Acciones rápidas" data-barra-movil>
	<a class="barra__boton" href={`tel:${empresa.telefono.enlace}`}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3h3l1.5 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3Z" /></svg>
		Llamar
	</a>
	{
		empresa.whatsapp && (
			<a class="barra__boton" href={`https://wa.me/${empresa.whatsapp.enlace.replace('+', '')}`}>
				WhatsApp
			</a>
		)
	}
	<a class="barra__boton barra__boton--principal" href={ctaPrincipal.href}>{ctaPrincipal.texto}</a>
</nav>

<style>
	.barra {
		display: none;
	}
	@media (max-width: 820px) {
		.barra {
			position: fixed;
			inset: auto 0 0 0;
			z-index: calc(var(--z-nav) - 2);
			display: flex;
			gap: 4px;
			padding: var(--s-2) var(--g) calc(env(safe-area-inset-bottom, 0px) + var(--s-2));
			background: color-mix(in oklch, var(--noche) 96%, transparent);
			box-shadow: 0 -1px 0 color-mix(in oklch, var(--n0) 12%, transparent);
			transform: translateY(110%);
			transition: transform var(--d-media) var(--ease);
		}
		.barra.visible {
			transform: none;
		}
		:global(html.menu-abierto) .barra {
			transform: translateY(110%);
		}
	}
	.barra__boton {
		flex: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--s-2);
		min-height: 48px;
		padding: 0 var(--s-3);
		background: color-mix(in oklch, var(--n0) 10%, transparent);
		color: var(--n0);
		font: 700 var(--t-sm) / 1.1 var(--f-texto);
		text-align: center;
		text-decoration: none;
		transition:
			background-color var(--d-media) var(--ease),
			transform var(--d-rapida) var(--ease);
	}
	.barra__boton:active {
		transform: scale(0.97);
	}
	.barra__boton--principal {
		flex: 1.4;
		background: var(--azul);
	}
	.barra svg {
		flex: none;
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.barra :focus-visible {
		outline-color: var(--azul-claro);
		outline-offset: -3px;
	}
</style>

<script>
	const barra = document.querySelector<HTMLElement>('[data-barra-movil]');
	if (barra) {
		const pie = document.querySelector('footer');
		// Visible cuando se ha dejado atrás la portada (o, en páginas sin portada, tras un poco de scroll)
		function actualizar() {
			const fin = document.querySelector('[data-fin-portada]');
			const pasada = fin ? fin.getBoundingClientRect().top < window.innerHeight * 0.6 : window.scrollY > 320;
			// Se oculta en cuanto asoma el pie, que ya muestra teléfono y email en grande
			const pieVisible = pie ? pie.getBoundingClientRect().top < window.innerHeight : false;
			barra!.classList.toggle('visible', pasada && !pieVisible);
		}
		window.addEventListener('scroll', actualizar, { passive: true });
		window.addEventListener('resize', actualizar);
		actualizar();
	}
</script>

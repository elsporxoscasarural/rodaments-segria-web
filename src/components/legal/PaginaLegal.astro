---
// Plantilla de los textos legales: migas, título, fecha y estilos de lectura.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Migas from '../Migas.astro';

interface Props {
	titulo: string;
	descripcion: string;
	actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---

<BaseLayout title={`${titulo} | Rodaments Segrià`} description={descripcion}>
	<article class="legal">
		<header>
			<Migas ruta={[{ texto: titulo }]} />
			<h1>{titulo}</h1>
			<p class="actualizado">Última actualización: {actualizado}</p>
		</header>
		<div class="texto">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.legal {
		padding: var(--s-8) var(--g) var(--seccion);
		background: var(--n0);
	}
	header {
		margin-bottom: var(--s-7);
		padding-bottom: var(--s-6);
		border-bottom: 2px solid var(--noche);
	}
	h1 {
		margin-block: var(--s-4) var(--s-3);
		color: var(--noche);
		font-size: clamp(2.75rem, 6vw, 5rem);
		line-height: var(--lh-display-tildes);
	}
	.actualizado {
		font-size: var(--t-sm);
		color: var(--n6);
	}
	.texto {
		max-width: 72ch;
	}
	.texto :global(h2) {
		margin-block: var(--s-7) var(--s-4);
		color: var(--noche);
		font-size: clamp(1.6rem, 2.6vw, 2.2rem);
	}
	.texto :global(p),
	.texto :global(li) {
		max-width: none;
		line-height: 1.7;
	}
	.texto :global(p + p) {
		margin-top: var(--s-4);
	}
	.texto :global(ul) {
		display: grid;
		gap: var(--s-2);
		margin: var(--s-4) 0;
		padding-left: 1.2em;
	}
	.texto :global(dl) {
		display: grid;
		grid-template-columns: minmax(10rem, max-content) minmax(0, 1fr);
		gap: var(--s-2) var(--s-6);
		margin: var(--s-4) 0;
	}
	.texto :global(dt) {
		font-weight: 700;
		color: var(--tinta);
	}
	.texto :global(dd) {
		margin: 0;
	}
	.texto :global(a) {
		overflow-wrap: anywhere;
		color: var(--azul);
	}
	.texto :global(table) {
		width: 100%;
		margin: var(--s-4) 0;
		border-collapse: collapse;
		font-size: var(--t-sm);
	}
	.texto :global(th),
	.texto :global(td) {
		padding: var(--s-3);
		border-bottom: 1px solid var(--n2);
		text-align: left;
		vertical-align: top;
	}
	.texto :global(th) {
		color: var(--tinta);
	}
	@media (max-width: 560px) {
		.texto :global(dl) {
			grid-template-columns: minmax(0, 1fr);
		}
		.texto :global(dd) {
			margin-bottom: var(--s-3);
		}
	}
</style>

---
// Catálogos: todos los PDF y catálogos online, por familia y categoría, con un buscador.
// Pensada para los comerciales en las visitas (móvil o tablet) y para clientes que buscan una ficha técnica.
// Los datos salen de src/content/catalogos.yaml.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Migas from '../components/Migas.astro';
import ListaCatalogos from '../components/ListaCatalogos.astro';
import { getCatalogos } from '../utils/catalogos';
import { empresa } from '../data/empresa';

const catalogos = await getCatalogos();
const familias = (await getCollection('familias')).sort((a, b) => a.data.orden - b.data.orden);
const categorias = (await getCollection('categorias')).sort((a, b) => a.data.orden - b.data.orden);

const grupos = familias
	.map((f) => ({
		familia: f,
		categorias: categorias
			.filter((c) => c.data.familia.id === f.id)
			.map((c) => ({
				categoria: c,
				catalogos: catalogos
					.filter((k) => k.categorias.includes(c.id))
					.sort((a, b) => Number(a.externo) - Number(b.externo)),
			}))
			.filter((g) => g.catalogos.length > 0),
	}))
	.filter((g) => g.categorias.length > 0);

const totalPdf = catalogos.filter((c) => !c.externo).length;
---

<BaseLayout
	title="Catálogos y fichas técnicas | Rodaments Segrià"
	description="Catálogos en PDF y fichas técnicas de rodamientos, soportes, correas, cadenas, piñones, poleas, mangueras, acoplamientos y más. Consúltalos o descárgalos."
>
	<section class="catalogos-pagina" aria-labelledby="t-catalogos">
		<header class="catalogos-pagina__cabecera">
			<Migas ruta={[{ texto: 'Catálogos' }]} />
			<h1 id="t-catalogos">Catálogos y fichas técnicas</h1>
			<p>
				{`${totalPdf} catálogos en PDF y los catálogos online de nuestras marcas. Se abren en una pestaña nueva y puedes descargarlos.`}
				{' '}¿No encuentras el que buscas? Pídenoslo al <a href={`tel:${empresa.telefono.enlace}`}>{empresa.telefono.visible}</a>.
			</p>
			<div class="buscador" role="search">
				<label for="buscar-catalogo">Buscar por marca o producto</label>
				<input id="buscar-catalogo" type="search" placeholder="Ej.: Challenge, correas…" autocomplete="off" spellcheck="false" data-buscar-catalogo />
				<p class="buscador__vacio" data-sin-resultados hidden>No hay ningún catálogo con ese nombre. Prueba con la marca o el tipo de producto.</p>
			</div>
			<nav class="indice" aria-label="Familias">
				<ul>
					{grupos.map((g) => (
						<li><a href={`#${g.familia.id}`}>{g.familia.data.nombre}</a></li>
					))}
				</ul>
			</nav>
		</header>

		{
			grupos.map((g) => (
				<section class="familia-catalogos" id={g.familia.id} aria-labelledby={`t-${g.familia.id}`} data-grupo>
					<h2 id={`t-${g.familia.id}`}>
						<a href={`/productos/${g.familia.id}`}>{g.familia.data.nombre}</a>
					</h2>
					{g.categorias.map((c) => (
						<div class="categoria-catalogos" data-grupo data-texto={c.categoria.data.nombre.toLowerCase()}>
							<h3>{c.categoria.data.nombre}</h3>
							<ListaCatalogos catalogos={c.catalogos} conBusqueda />
						</div>
					))}
				</section>
			))
		}
	</section>
</BaseLayout>

<style>
	.catalogos-pagina {
		padding: var(--s-6) var(--g) var(--seccion);
	}
	.catalogos-pagina__cabecera {
		display: grid;
		gap: var(--s-5);
		margin-bottom: var(--s-7);
	}
	.catalogos-pagina__cabecera h1 {
		max-width: 16ch;
		color: var(--noche);
		font-size: var(--t-1);
		line-height: var(--lh-display-tildes);
	}
	.catalogos-pagina__cabecera > p {
		max-width: 60ch;
		font-size: var(--t-lead);
	}
	.catalogos-pagina__cabecera > p a {
		font-weight: 700;
		color: var(--noche);
		white-space: nowrap;
	}

	/* Buscador: grande y a mano, se usa con el dedo */
	.buscador {
		display: grid;
		gap: var(--s-2);
		max-width: 40rem;
	}
	.buscador label {
		font-weight: 700;
		font-size: var(--t-sm);
		color: var(--noche);
	}
	.buscador input {
		width: 100%;
		min-height: 56px;
		padding: 0 var(--s-4);
		border: 2px solid var(--noche);
		border-radius: 0;
		background: var(--n0);
		color: var(--tinta);
		font: 500 1.125rem / 1.2 var(--f-texto);
	}
	.buscador input:focus-visible {
		outline: 3px solid var(--azul);
		outline-offset: 2px;
	}
	.buscador__vacio {
		color: var(--n6);
	}

	.indice ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.indice a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 var(--s-4);
		border: 1px solid var(--n3);
		color: var(--noche);
		font-weight: 600;
		font-size: var(--t-sm);
		text-decoration: none;
		transition:
			background-color var(--d-media) var(--ease),
			border-color var(--d-media) var(--ease);
	}
	.indice a:hover {
		border-color: var(--noche);
		background: var(--n1);
	}

	.familia-catalogos {
		padding-block: var(--s-7) var(--s-4);
		border-top: 2px solid var(--noche);
		scroll-margin-top: 96px;
	}
	.familia-catalogos h2 {
		margin-bottom: var(--s-5);
		font-size: var(--t-2);
		line-height: var(--lh-display-tildes);
	}
	.familia-catalogos h2 a {
		color: var(--noche);
		text-decoration: none;
	}
	.familia-catalogos h2 a:hover {
		color: var(--azul);
	}
	.categoria-catalogos + .categoria-catalogos {
		margin-top: var(--s-6);
	}
	.categoria-catalogos h3 {
		margin-bottom: var(--s-3);
		font: 700 var(--t-xs) / 1.2 var(--f-texto);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--n6);
	}
	[data-grupo][hidden] {
		display: none;
	}
</style>

<script>
	// Buscador: filtra por marca, título o categoría y oculta los grupos que se quedan vacíos.
	const campo = document.querySelector<HTMLInputElement>('[data-buscar-catalogo]');
	const vacio = document.querySelector<HTMLElement>('[data-sin-resultados]');
	const normalizar = (t: string) =>
		t
			.toLowerCase()
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '');

	campo?.addEventListener('input', () => {
		const palabras = normalizar(campo.value).split(/\s+/).filter(Boolean);
		let visibles = 0;
		document.querySelectorAll<HTMLElement>('.categoria-catalogos').forEach((grupo) => {
			const categoria = normalizar(grupo.dataset.texto ?? '');
			let enGrupo = 0;
			grupo.querySelectorAll<HTMLElement>('[data-catalogo]').forEach((item) => {
				const texto = `${normalizar(item.dataset.catalogo ?? '')} ${categoria}`;
				const coincide = palabras.every((p) => texto.includes(p));
				item.hidden = !coincide;
				if (coincide) enGrupo++;
			});
			grupo.hidden = enGrupo === 0;
			visibles += enGrupo;
		});
		document.querySelectorAll<HTMLElement>('.familia-catalogos').forEach((familia) => {
			familia.hidden = !familia.querySelector('.categoria-catalogos:not([hidden])');
		});
		if (vacio) vacio.hidden = visibles > 0;
	});
</script>

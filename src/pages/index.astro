---
// Portada. Recorrido: fachada → almacén por dentro → familias → buscar referencia → Carburos → contacto (pie).
import BaseLayout from '../layouts/BaseLayout.astro';
import Portada from '../components/inicio/Portada.astro';
import Familias from '../components/inicio/Familias.astro';
import BuscadorReferencia from '../components/inicio/BuscadorReferencia.astro';
import BloqueCarburos from '../components/inicio/BloqueCarburos.astro';
---

<BaseLayout
	title="Rodamientos y suministro industrial en Lleida | Rodaments Segrià"
	description="Empresa familiar de Lleida desde 1988. Más de 500.000 referencias en stock: rodamientos, soportes, correas, transmisión, retenes y material de taller para industria y agricultura."
	portada
>
	<Portada />
	<Familias />
	<BuscadorReferencia />
	<BloqueCarburos />
</BaseLayout>
